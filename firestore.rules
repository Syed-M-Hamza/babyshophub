rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false;
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.isActive == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.phone is string
        && request.resource.data.profileImage is string
        && request.resource.data.createdAt == request.time;
      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() > 1
        ) || (
          isAdmin()
          && onlyChanged(['isActive'])
          && request.resource.data.isActive is bool
        );
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, write: if isActiveUser() && request.auth.uid == uid;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isActiveUser() && (
          (
            onlyChanged(['stock', 'lastOrderId'])
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
          ) || (
            onlyChanged(['rating', 'reviewCount'])
            && request.resource.data.reviewCount == resource.data.reviewCount + 1
            && request.resource.data.rating is number
            && request.resource.data.rating >= 0
            && request.resource.data.rating <= 5
          )
        )
      );
    }

    match /carts/{cartId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && cartId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 20;
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 20;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /wishlists/{wishId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && wishId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.productId is string;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.products is list
        && request.resource.data.products.size() > 0
        && request.resource.data.products.size() <= 20
        && request.resource.data.paymentMethod in ['cod', 'dummy_online']
        && request.resource.data.subtotal is int
        && request.resource.data.deliveryCharges in [0, 150]
        && request.resource.data.totalAmount == request.resource.data.subtotal + request.resource.data.deliveryCharges
        && request.resource.data.customerName is string
        && request.resource.data.address is string
        && (
          (request.resource.data.paymentMethod == 'cod'
            && request.resource.data.paymentStatus == 'pending'
            && request.resource.data.orderStatus == 'placed')
          || (request.resource.data.paymentMethod == 'dummy_online'
            && request.resource.data.paymentStatus == 'paid'
            && request.resource.data.orderStatus == 'confirmed')
        );
      allow update: if isAdmin() || (
        isActiveUser()
        && resource.data.userId == request.auth.uid
        && onlyChanged(['orderStatus', 'updatedAt'])
        && resource.data.orderStatus in ['placed', 'confirmed']
        && request.resource.data.orderStatus == 'cancelled'
      );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if isActiveUser()
        && reviewId == request.auth.uid + '_' + request.resource.data.productId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /support_tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.adminResponse == ''
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveUser() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && onlyChanged(['read'])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /checkout_locks/{uid} {
      allow read, write: if isActiveUser() && request.auth.uid == uid;
    }

    match /sellers/{sellerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /seller_feedback/{feedbackId} {
      allow read: if signedIn();
      allow create, update: if isActiveUser()
        && feedbackId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3;
      allow delete: if isAdmin();
    }
  }
}
